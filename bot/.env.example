# ─────────────────────────────────────────────────────────────
#  YT-DLP Telegram Bot — конфигурация окружения
#  Скопируйте в .env и заполните значения.
#  НИКОГДА не коммитьте .env в git!
# ─────────────────────────────────────────────────────────────

# ── Обязательное ──────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456789:ABCDEFabcdefABCDEF1234567890abcdef

# Ваш числовой Telegram user ID (найти через @userinfobot)
# Несколько администраторов — через запятую: 111111,222222
# Эти ID — суперадмины (👑): одобряют/банят пользователей, видят полную
# статистику. Список задаётся ТОЛЬКО здесь (команды /addadmin нет);
# при изменении списка перезапустите бот — права синхронизируются с БД.
ADMIN_IDS=123456789

# ── Локальный Telegram Bot API сервер (ОБЯЗАТЕЛЬНО для файлов > 50 МБ) ────────
# Получите на https://my.telegram.org → API development tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# URL локального сервера (при использовании docker-compose — не менять)
LOCAL_API_SERVER=http://telegram-bot-api:8081

# ── Контроль доступа ──────────────────────────────────────────
# "closed" — администратор одобряет каждого пользователя вручную (рекомендуется)
# "open"   — любой, кто написал боту, получает доступ
REGISTRATION_MODE=closed

# ── Лимиты загрузки ───────────────────────────────────────────
# Максимальный размер файла в МБ
# С локальным Bot API сервером — до 10240 МБ (10 ГБ)
# Без локального сервера — максимум 50 МБ (жёсткий лимит Telegram)
MAX_FILE_SIZE_MB=10240

# Таймаут загрузки в секундах (для больших файлов увеличьте)
DOWNLOAD_TIMEOUT=3600

# Таймаут получения метаданных (редиректы/неотвечающие сайты не блокируют бота)
INFO_TIMEOUT=120

# Максимальное количество одновременных загрузок
MAX_CONCURRENT_DOWNLOADS=3

# Максимум активных загрузок одного пользователя
MAX_CONCURRENT_DOWNLOADS_PER_USER=1

# Сколько записей истории хранить на пользователя (0 — не ограничивать)
MAX_HISTORY_PER_USER=50

# Неприкосновенный резерв свободного места и общий лимит одного плейлиста
MIN_FREE_DISK_MB=1024
MAX_PLAYLIST_TOTAL_MB=10240

# ── Пути (должны совпадать с volume mounts в docker-compose.yml) ─
DOWNLOAD_DIR=/downloads
DB_PATH=/data/bot.db

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Включить контейнер cloudflared.
# true  — deploy.sh добавит compose-profile cloudflare и запустит cloudflared.
# false — cloudflared не собирается/не запускается, бот не ждёт Quick Tunnel.
ENABLE_CLOUDFLARED=false

# Включить временный Cloudflare Quick Tunnel без токена.
# Держите false для nginx/direct/relay схем. Для Named Tunnel этот флаг не нужен.
ENABLE_CLOUDFLARE_QUICK_TUNNEL=false

# Токен Named Tunnel из Cloudflare Dashboard → Zero Trust → Networks → Tunnels.
# Для Named Tunnel: ENABLE_CLOUDFLARED=true и задайте токен.
# Для Quick Tunnel: ENABLE_CLOUDFLARED=true, ENABLE_CLOUDFLARE_QUICK_TUNNEL=true,
# а токен оставьте пустым.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Файловый HTTP-сервер (раздача ссылок вместо загрузки в Telegram) ──────────
# Публичный адрес через Cloudflare Tunnel (без trailing slash).
# Если задан — бот предлагает кнопку «🔗 Ссылка через Cloudflare».
# С Cloudflare Named Tunnel: https://ваш-поддомен.domain.com
# С Cloudflare Quick Tunnel: смотрите ./deploy.sh logs cloudflared
# Если ENABLE_CLOUDFLARED=false, оставьте пустым и используйте DIRECT_BASE_URL/RELAY_BASE_URLS.
PUBLIC_BASE_URL=

# Прямой HTTPS-адрес сервера через nginx-ssl (без trailing slash).
# Если задан — бот предлагает кнопку «🌐 Прямая ссылка с сервера».
# Используется с sslip.io (технический домен для IP без своего домена).
# Пример: https://15-24-9-1.sslip.io:7443
# Можно использовать одновременно с PUBLIC_BASE_URL — будут 3 кнопки:
#   📤 Telegram | 🔗 Cloudflare | 🌐 С сервера
DIRECT_BASE_URL=

# Relay-серверы — резервные пути для пользователей, у которых заблокирован Cloudflare
# и/или прямой IP. Каждый relay проксирует /info/ и /dl/ на бот-сервер.
# При установке добавляются кнопки: 🔄 Relay 1, Relay 2...
# Пример: https://1-2-3-4.sslip.io:5443
# Несколько relay через запятую:
# RELAY_BASE_URLS=https://relay1.example.com,https://relay2.example.com
# На relay-сервере нужно добавить location в nginx (см. docs/nginx-relay-ytdlp.conf.example)
RELAY_BASE_URL=
RELAY_BASE_URLS=

# Порт внутреннего HTTP-сервера (файловый сервер внутри ytdlp-bot)
HTTP_PORT=8080

# ── Nginx SSL (прямой HTTPS по IP, профиль "ssl") ─────────────────────────────
# Для включения: COMPOSE_PROFILES=ssl (в .env или при запуске).
# Cloudflare profile управляется отдельно через ENABLE_CLOUDFLARED.
#
# Технический домен через sslip.io: A-B-C-D.sslip.io → A.B.C.D
# Обязателен для nginx-ssl контейнера. БЕЗ порта — только домен.
SSLIP_DOMAIN=15-24-9-1.sslip.io

# Порт HTTPS для прямого доступа (443 занят — используем 7443)
HTTPS_PORT=7443

# Let's Encrypt: включить/выключить автоматическое получение сертификата.
# Для LE cert нужен порт 80 доступный извне (nftables DNAT → 10.10.2.5:80).
# Перенаправьте порт 80 вручную перед первым запуском, затем можете убрать.
# При ENABLE_CERTBOT=false — используется self-signed cert (шифрование есть).
ENABLE_CERTBOT=true

# Email для Let's Encrypt (необязателен).
# Если пуст — certbot работает без email (--register-unsafely-without-email).
# С email — LE пришлёт уведомление если сертификат истекает.
CERTBOT_EMAIL=

# Активация nginx-ssl контейнера (раскомментировать для включения).
# Не добавляйте сюда cloudflare при ENABLE_CLOUDFLARED=false.
#COMPOSE_PROFILES=ssl

# Время жизни ссылки в часах (файл удаляется после скачивания или по истечению)
FILE_TTL_HOURS=1

# Секретный ключ для HMAC-подписи токенов файлового сервера (рекомендуется!)
# Генерация: python3 -c "import secrets; print(secrets.token_hex(32))"
SERVER_SECRET=

# Лимит запросов к файловому серверу с одного IP за минуту
FS_RATE_LIMIT=30

# Анти-флуд: сколько «дорогих» действий (разбор ссылок, приём .torrent)
# один пользователь может инициировать в минуту. Лимит на ОДНОВРЕМЕННЫЕ
# загрузки (MAX_CONCURRENT_DOWNLOADS_PER_USER) очередь запросов не ограничивал.
USER_ACTIONS_PER_MINUTE=20

# ── Функции ─────────────────────────────────────────────────────
ALLOW_PLAYLISTS=true
ALLOW_AUDIO=true
ALLOW_SUBTITLES=true
# Аудио в формате OPUS — ремукс без перекодирования, значительно быстрее MP3.
# YouTube хранит аудио уже в OPUS, поэтому конвертации не требуется.
ALLOW_OPUS=true
# Аудио в формате WAV (несжатый PCM) — без потерь, максимальное качество.
# Внимание: файлы очень большие (~10 МБ на минуту). Отключено по умолчанию.
ALLOW_WAV=false
# Максимальное количество видео в плейлисте.
# Кнопки меню покажут N÷2 и N видео на выбор.
MAX_PLAYLIST_ITEMS=10
# Ускорение загрузки через aria2c (16 параллельных соединений)
# Требует aria2 (уже установлен в Docker-образе)
USE_ARIA2C=true
# SponsorBlock: off | remove (вырезать рекламу) | mark (разметить главами).
# Старый USE_SPONSORBLOCK=true продолжает работать как remove.
USE_SPONSORBLOCK=false
SPONSORBLOCK_MODE=off

# ── Постобработка файлов ─────────────────────────────────────────
# Вшивать обложку в файл (mp3/m4a/mp4/opus/flac). Telegram показывает её в плеере.
EMBED_THUMBNAIL=true
# Вшивать теги (исполнитель, название, описание)
EMBED_METADATA=true
# Вшивать главы видео в контейнер
EMBED_CHAPTERS=true
# Скачивать стримы с начала эфира, а не с текущего момента
LIVE_FROM_START=false

# ── Отрывки и главы ──────────────────────────────────────────────
# Кнопка «✂️ Отрывок»: бот попросит прислать интервал вида 10:00-12:30
ALLOW_CLIPS=true
# Максимальная длина отрывка в секундах (по умолчанию 2 часа)
MAX_CLIP_SECONDS=7200
# Кнопка «🔖 По главам»: разбивает видео на файлы по главам.
# Осторожно: у длинного подкаста это десятки файлов.
ALLOW_SPLIT_CHAPTERS=false

# ── JavaScript-рантайм (обязателен для YouTube) ──────────────────
# yt-dlp решает n/sig-челленджи YouTube внешним JS-движком: без него клиент
# `web` выпадает из списка по умолчанию и часть форматов пропадает.
# В образ уже установлен deno. Варианты: deno, node, quickjs, bun (через запятую).
JS_RUNTIMES=deno

# ── Подмена TLS-отпечатка (curl_cffi) ────────────────────────────
# Снимает блокировки на Instagram/TikTok/X. Примеры: chrome, chrome:windows-10, safari.
# Пусто = выключено.
# ⚠ curl_cffi ходит через libcurl мимо socket.getaddrinfo, то есть ОБХОДИТ
#   SSRF-guard бота. При SSRF_PROTECTION=true бот потребует явного согласия:
IMPERSONATE=
TRUST_IMPERSONATE_FOR_SSRF=false

# ── PO Token (YouTube: «Sign in to confirm you're not a bot») ────
# Вариант 1 — контейнер-провайдер (профиль pot):
#   ENABLE_POT_PROVIDER=true и POT_PROVIDER_URL=http://bgutil-pot:4416
# Порт наружу не публикуется; хост провайдера бот сам добавляет в allowlist
# SSRF-guard. Контейнеру нужен исходящий доступ (10.10.2.6 в MASQUERADE).
ENABLE_POT_PROVIDER=false
POT_PROVIDER_URL=
# Вариант 2 — токены вручную, формат CLIENT.CONTEXT+TOKEN через запятую:
#   YOUTUBE_PO_TOKEN=web.gvs+XXX,web.player+YYY
YOUTUBE_PO_TOKEN=
# Переопределение клиентов YouTube (например: default,-web либо tv_simply)
YOUTUBE_PLAYER_CLIENT=

# ─── BitTorrent (magnet + .torrent) ──────────────────────────────────────────
# ⚠ ПО УМОЛЧАНИЮ ВЫКЛЮЧЕНО. Скачивание через aria2c (уже в образе).
#
# Модель безопасности (см. подробно TELEGRAM_BOT.md → «BitTorrent»):
#   • Входящий торрент-порт НЕ публикуется и НЕ проксируется nftables → недостижим
#     извне. Не добавляйте TORRENT_LISTEN_PORT в ports: docker-compose.
#   • Бот НЕ сидирует (--seed-time=0) → только исходящие соединения к пирам.
#   • DHT/LPD/PEX выключены → нет UDP-listener'ов и анонсов себя в DHT.
#   • aria2c (подпроцесс) НЕ наследует Python-SSRF-guard. IP пиров он не фильтрует,
#     поэтому доступ контейнера в приватную сеть ОБЯЗАТЕЛЬНО закрывать nftables
#     egress-правилами (готовый сниппет — в TELEGRAM_BOT.md).
#
# ⚠ При TORRENT_ENABLE_DHT=false magnet без трекеров (&tr=) может не получить
#   метаданные — используйте magnet с трекерами или .torrent-файл.
ALLOW_TORRENTS=false
# Агрегатный лимит размера всей раздачи (МБ). По умолчанию как у плейлиста.
TORRENT_MAX_TOTAL_MB=10240
# Таймаут всей торрент-загрузки (секунды). Торренты медленные — дефолт 2 часа.
TORRENT_TIMEOUT=7200
# Ограничение числа пиров и скорости (байт/с, 0 = без лимита).
TORRENT_MAX_PEERS=50
TORRENT_DOWNLOAD_LIMIT=0
# Фиксированный listen-порт (нужен для явного DROP в nftables). НЕ пробрасывать наружу.
TORRENT_LISTEN_PORT=51413
# DHT: безопаснее держать выключенным (нет UDP-анонсов себя).
TORRENT_ENABLE_DHT=false
# Отдавать только медиа-файлы (video/audio) из раздачи.
TORRENT_MEDIA_ONLY=true
# Максимальный размер принимаемого .torrent-файла (МБ).
TORRENT_FILE_MAX_MB=2

# Generic HTTP extractor для произвольных сайтов.
# false безопаснее для публичного бота: снижает SSRF-риск через редиректы/HLS/DASH.
ALLOW_GENERIC_URLS=false

# Повторно проверять DNS при каждом сетевом соединении yt-dlp, включая редиректы.
SSRF_PROTECTION=true

# Разрешайте только если PROXY_URL указывает на прокси с собственной SSRF-фильтрацией.
TRUST_PROXY_FOR_SSRF=false

# Доверенные reverse proxy для заголовков с IP клиента (файловый сервер).
# Приоритет заголовков: CF-Connecting-IP (Cloudflare) → X-Real-IP (nginx) →
# последний элемент X-Forwarded-For. От недоверенных IP заголовки игнорируются.
#
# ⚠ Про relay: добавлять сюда IP relay-серверов БЕСПОЛЕЗНО. Бот видит своим
#   пиром nginx-ssl (10.10.2.5, уже доверенный), а тот сам выставляет
#   X-Real-IP=$remote_addr, то есть адрес relay. Поэтому весь relay считается
#   одним клиентом и делит один лимит FS_RATE_LIMIT (30 запросов в минуту),
#   как и лимит nginx (limit_req 30r/m).
#   Чтобы дать пользователям relay индивидуальные лимиты, включите на nginx-ssl
#   модуль realip (тогда $remote_addr станет реальным клиентом):
#       set_real_ip_from <IP relay>;
#       real_ip_header X-Forwarded-For;
#       real_ip_recursive on;
#   Иначе просто поднимите FS_RATE_LIMIT под ожидаемое число пользователей relay.
FS_TRUSTED_PROXY_CIDRS=10.10.2.0/24,127.0.0.1/32,::1/128

# ── Webhook (альтернатива polling) ───────────────────────────────
# Если задан — бот использует webhook вместо polling.
# WEBHOOK_URL — публичный HTTPS-адрес бота (без trailing slash).
# Пример с Cloudflare Named Tunnel: https://bot.example.com
# Оставьте пустым чтобы использовать polling (режим по умолчанию).
#
# ⚠ WEBHOOK_PORT не публикуется docker-compose и не проксируется nginx-ssl
#   из коробки. Перед включением webhook доведите трафик до контейнера сами:
#   Cloudflare Named Tunnel на http://ytdlp-bot:8443 (рекомендуется) либо
#   свой location в nginx + DNAT в nftables. Без этого Telegram не достучится
#   до бота, и он замолчит — polling при этом отключается.
WEBHOOK_URL=
# Порт для приёма webhook-запросов (отдельный от файлового сервера HTTP_PORT=8080)
WEBHOOK_PORT=8443
# Секрет для верификации webhook-запросов от Telegram (обязателен при WEBHOOK_URL)
# Генерация: python3 -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET_TOKEN=

# ── Мониторинг диска ─────────────────────────────────────────────
# Процент заполнения диска, при котором бот отправит алерт всем администраторам.
# Алерт повторяется не чаще 1 раза в 4 часа. 0 — выключено.
DISK_ALERT_THRESHOLD=80

# ── Опциональное ──────────────────────────────────────────────
# HTTP/SOCKS прокси (оставить пустым для отключения)
PROXY_URL=

# Путь к файлу куки (Netscape-формат) для контента 18+
# (монтируется как read-only в docker-compose.yml)
COOKIES_FILE=

# Авто-удаление сообщений бота после завершения загрузки (секунды).
# 0 — выключено. Пример: AUTO_DELETE_SECONDS=300 → удаляет через 5 мин.
AUTO_DELETE_SECONDS=0

# Служебные сообщения (ошибки, «ссылка не распознана», лимиты, итоги пачек)
# удаляются всегда через столько секунд — они не несут результата и только
# засоряют чат. 0 = не удалять.
TRANSIENT_DELETE_SECONDS=60

# Удалять сообщение со ссылкой, когда истёк TTL файла (ссылка уже нерабочая)
DELETE_EXPIRED_LINK_MESSAGES=true
